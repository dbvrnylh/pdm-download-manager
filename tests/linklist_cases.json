[
  {
    "name": "un lien par ligne, dans l'ordre ; commentaires, lignes vides et BOM ignorés",
    "text": "﻿# Cours\r\nhttps://x.com/b.pdf\n\n   https://x.com/a.pdf  \r# fin\n",
    "expect": {
      "entries": [
        {
          "line": 2,
          "urls": [
            "https://x.com/b.pdf"
          ],
          "options": {}
        },
        {
          "line": 4,
          "urls": [
            "https://x.com/a.pdf"
          ],
          "options": {}
        }
      ],
      "invalid": [],
      "warnings": [],
      "duplicates": 0
    }
  },
  {
    "name": "doublons comptés une fois, lignes refusées avec leur numéro et la raison",
    "text": "https://x.com/a.zip\nHTTP://x.com/b.zip\nhttps://x.com/a.zip\nwww.x.com/c.zip\nftp://x.com/d.zip\nhttps://x.com/e.zip https://x.com/f.zip\nhttps://\nmailto:moi@x.com",
    "expect": {
      "entries": [
        {
          "line": 1,
          "urls": [
            "https://x.com/a.zip"
          ],
          "options": {}
        },
        {
          "line": 2,
          "urls": [
            "HTTP://x.com/b.zip"
          ],
          "options": {}
        }
      ],
      "invalid": [
        {
          "line": 4,
          "text": "www.x.com/c.zip",
          "reason": "il manque https:// au début"
        },
        {
          "line": 5,
          "text": "ftp://x.com/d.zip",
          "reason": "seuls les liens http:// et https:// sont acceptés"
        },
        {
          "line": 6,
          "text": "https://x.com/e.zip https://x.com/f.zip",
          "reason": "plusieurs liens sur la ligne : un par ligne, ou des miroirs séparés par une tabulation"
        },
        {
          "line": 7,
          "text": "https://",
          "reason": "adresse mal formée"
        },
        {
          "line": 8,
          "text": "mailto:moi@x.com",
          "reason": "seuls les liens http:// et https:// sont acceptés"
        }
      ],
      "warnings": [],
      "duplicates": 1
    }
  },
  {
    "name": "miroirs séparés par une tabulation, options en retrait (header se répète, dir et l'inconnue ignorées)",
    "text": "https://x.com/f.iso\thttps://m1.example/f.iso\t https://m2.example/f.iso\n  out=fedora.iso\n\tchecksum=sha-256=abc\n  header=X-A: 1\n  header=X-B: 2\n  max-tries=5\n  DIR=/srv/iso\n  frobnicate=1\n# un commentaire n'arrête pas les options\n  split=4\nhttps://x.com/g.iso\n  pause=true",
    "expect": {
      "entries": [
        {
          "line": 1,
          "urls": [
            "https://x.com/f.iso",
            "https://m1.example/f.iso",
            "https://m2.example/f.iso"
          ],
          "options": {
            "out": "fedora.iso",
            "checksum": "sha-256=abc",
            "header": [
              "X-A: 1",
              "X-B: 2"
            ],
            "split": "4"
          }
        },
        {
          "line": 11,
          "urls": [
            "https://x.com/g.iso"
          ],
          "options": {
            "pause": "true"
          }
        }
      ],
      "invalid": [],
      "warnings": [
        {
          "line": 7,
          "text": "DIR=/srv/iso",
          "reason": "dir ignoré : PDM range les fichiers dans son dossier, par catégorie"
        },
        {
          "line": 8,
          "text": "frobnicate=1",
          "reason": "option inconnue, ignorée : frobnicate"
        }
      ],
      "duplicates": 0
    }
  },
  {
